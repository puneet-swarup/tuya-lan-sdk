root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[*.kt]
indent_size = 4
max_line_length = 120

[*.{gradle,kts}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{bat,cmd,ps1}]
end_of_line = crlf
